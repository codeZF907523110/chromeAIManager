{
  "name": "chrome-ai-manager",
  "version": "0.1.0",
  "description": "键盘驱动的 AI 浏览器命令中心 — Vue 3 + TypeScript 重构版",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{vue,ts,css}\"",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{vue,ts,css}\"",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "test": "node -r ./tests/crypto-polyfill.cjs ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@lucide/vue": "^1.28.0",
    "dompurify": "^3.4.13",
    "element-plus": "^2.14.3",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.7",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/tsconfig": "^0.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.0",
    "vite": "^4.5.5",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.0"
  }
}
